.pcard {
  background: #fff;
  border: 2rpx solid rgba(196,198,207,0.3);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.pcard .cover {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: #f1f1f1;
}
.pcard .cover .img { width: 100%; height: 100%; }
.pcard .badge {
  position: absolute; top: 32rpx; left: 32rpx;
  padding: 6rpx 16rpx;
  background: rgba(0,32,69,0.9);
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.pcard .badge-fire { background: #FC6C29; color: #5A1C00; }
.pcard .admin-ops {
  position: absolute; top: 24rpx; right: 24rpx;
  display: flex; gap: 16rpx;
}
.pcard .op-btn {
  background: rgba(255,255,255,0.95);
  color: #002045;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}
.pcard .op-btn.op-del { background: #ffebe5; color: #d23900; }
.pcard .body { padding: 32rpx; }
.pcard .title { font-size: 36rpx; color: #002045; font-weight: 600; }
.pcard .meta {
  margin-top: 16rpx;
  display: flex; gap: 32rpx;
  font-size: 22rpx; color: #43474E;
  font-family: Menlo, monospace;
}
.pcard .footer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(196,198,207,0.3);
  display: flex; justify-content: space-between; align-items: center;
}
.pcard .lab { font-size: 22rpx; color: #43474E; }
.pcard .sub { font-size: 28rpx; color: #002045; margin-top: 6rpx; }
.pcard .btn-inquiry {
  background: #F26522; color: #fff;
  padding: 18rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
