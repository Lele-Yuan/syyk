.pcard {
  background: #fff;
  border: 2rpx solid rgba(196,198,207,0.3);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  position: relative;
}
.pcard .cover {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: #f1f1f1;
}
.pcard .cover .img { width: 100%; height: 100%; }
.pcard .badge {
  position: absolute; top: 32rpx; left: 32rpx;
  padding: 6rpx 16rpx;
  background: rgba(0,32,69,0.9);
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.pcard .badge-fire { background: #FC6C29; color: #5A1C00; }
.pcard .admin-ops {
  position: absolute; top: 24rpx; right: 24rpx;
  display: flex; gap: 16rpx;
}
.pcard .op-btn {
  background: rgba(255,255,255,0.95);
  color: #002045;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}
.pcard .op-btn.op-del { background: #ffebe5; color: #d23900; }
.pcard .body {
  padding: 0;
  position: absolute;
  width: 100%;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pcard .title {
  width: 100%;
  text-align: center;
  font-size: 36rpx;
  color: #002045;
  font-weight: 600;
  padding: 32rpx 0;
  background: #ffffff80;
}
.pcard .meta {
  margin-top: 16rpx;
  display: flex; gap: 32rpx;
  font-size: 22rpx; color: #43474E;
  font-family: Menlo, monospace;
}
