.kv-wrap { display: flex; flex-direction: column; gap: 12rpx; }
.kv-row { display: flex; align-items: center; gap: 12rpx; }
.kv-i {
  flex: 1; height: 72rpx; padding: 0 20rpx;
  border: 2rpx solid #EBEEF0; border-radius: 12rpx;
  background: #fff; font-size: 26rpx;
}
.kv-rm {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  text-align: center; line-height: 56rpx;
  background: #ffebe5; color: #d23900; font-size: 36rpx;
}
.kv-add {
  margin-top: 12rpx;
  text-align: center; padding: 18rpx;
  background: #F1F4F6; border-radius: 12rpx;
  color: #A63B00; font-size: 26rpx;
}
