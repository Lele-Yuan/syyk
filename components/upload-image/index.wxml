<view class="up-wrap">
  <block wx:for="{{fileIDs}}" wx:key="*this">
    <view class="up-item">
      <image src="{{item}}" mode="aspectFill" class="img" data-i="{{index}}" bindtap="onPreview"/>
      <view class="del" data-i="{{index}}" catchtap="onRemove">×</view>
    </view>
  </block>
  <view wx:if="{{multiple || fileIDs.length === 0}}" class="up-add" bindtap="onAdd">
    <text class="plus">+</text>
    <text class="t">上传图片</text>
  </view>
</view>
