.up-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.up-item, .up-add {
  width: 180rpx; height: 180rpx;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
}
.up-item .img { width: 100%; height: 100%; }
.up-item .del {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 36rpx; height: 36rpx; line-height: 32rpx;
  text-align: center; color: #fff; font-size: 28rpx;
  background: rgba(0,0,0,0.55); border-radius: 50%;
}
.up-add {
  border: 2rpx dashed #C4C6CF;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #67717E;
}
.up-add .plus { font-size: 64rpx; line-height: 64rpx; color: #A63B00; }
.up-add .t { font-size: 22rpx; margin-top: 8rpx; }
