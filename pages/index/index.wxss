.home { background: #fff; min-height: 100vh; }
.banner { position: relative; width: 100%; height: 600rpx; }
.banner .sw { width: 100%; height: 100%; }
.banner .b-img { width: 100%; height: 100%; }
.banner .b-mask {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 80rpx 40rpx 64rpx;
  background: linear-gradient(0deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0) 100%);
  color: #fff;
}
.b-tag {
  display: inline-block;
  background: rgba(252,108,41,1);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}
.b-title { font-size: 48rpx; font-weight: 700; }
.b-sub { font-size: 26rpx; margin-top: 12rpx; opacity: 0.9; }
.b-dots {
  position: absolute; bottom: 32rpx; right: 40rpx;
  display: flex; gap: 12rpx;
}
.b-dots .d { width: 24rpx; height: 8rpx; border-radius: 4rpx; background: rgba(255,255,255,0.5); }
.b-dots .d-on { width: 48rpx; background: #fff; }

.offices {
  display: flex; gap: 16rpx;
  margin: 32rpx 0;
}
.o-card {
  flex: 1; background: #F1F4F6;
  border-radius: 16rpx; padding: 24rpx;
  display: flex; align-items: center;
}
.o-icon { font-size: 36rpx; margin-right: 16rpx; }
.o-city { font-size: 28rpx; color: #002045; font-weight: 600; }
.o-addr { font-size: 22rpx; color: #67717E; margin-top: 4rpx; }

.about-card {
  display: flex; gap: 24rpx;
  background: linear-gradient(135deg, #F1F4F6 0%, #fff 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 0 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,32,69,0.06);
}
.ac-left {
  width: 200rpx; flex-shrink: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 16rpx 0;
  border-right: 2rpx solid #E6E8ED;
}
.ac-logo {
  width: 120rpx; height: 120rpx; border-radius: 60rpx;
  background: linear-gradient(135deg, #002045, #1A365D);
  display: flex; align-items: center; justify-content: center;
}
.ac-logo text { font-size: 56rpx; }
.ac-link { margin-top: 16rpx; font-size: 24rpx; color: #A63B00; font-weight: 600; }
.ac-right {
  flex: 1; display: flex; flex-direction: column; gap: 20rpx;
  justify-content: center;
}
.ac-o { line-height: 1.5; }
.ac-city { font-size: 26rpx; color: #002045; font-weight: 600; }
.ac-addr { font-size: 22rpx; color: #67717E; margin-top: 4rpx; padding-left: 32rpx; }
.ac-empty { font-size: 24rpx; color: #C4C6CF; text-align: center; }

.entries {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  margin: 24rpx 0 48rpx;
}
.entry { display: flex; flex-direction: column; align-items: center; }
.entry-ic {
  width: 96rpx; height: 96rpx; border-radius: 24rpx;
  background: #FFF1E8;
  display: flex; align-items: center; justify-content: center;
}
.entry-ic image { width: 48rpx; height: 48rpx; }
.entry-ic text { font-size: 48rpx; line-height: 1; }
.entry-lab { margin-top: 12rpx; font-size: 24rpx; color: #002045; }

.case-scroll { white-space: nowrap; margin: 16rpx -40rpx 48rpx; padding-left: 40rpx; }
.cs-item {
  display: inline-block;
  width: 480rpx; margin-right: 24rpx;
  vertical-align: top;
}
.cs-img { width: 100%; height: 320rpx; border-radius: 24rpx; }
.cs-title { margin-top: 16rpx; font-size: 30rpx; color: #002045; font-weight: 600; }
.cs-sub { font-size: 22rpx; color: #67717E; margin-top: 4rpx; }

.brand-card {
  margin: 32rpx 0 0;
  background: #002045;
  border-radius: 32rpx;
  padding: 64rpx 48rpx;
  text-align: center;
  color: #fff;
}
.bc-title { font-size: 40rpx; font-weight: 700; }
.bc-sub { margin-top: 16rpx; font-size: 26rpx; color: #86A0CD; }
.bc-btn {
  display: inline-block; margin-top: 32rpx;
  padding: 24rpx 64rpx;
  background: #A63B00; color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx; font-weight: 600;
}

.fab-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 998;
}
.fab-overlay {
  position: fixed; right: 40rpx; bottom: 320rpx;
  z-index: 1001;
  display: flex; flex-direction: column; align-items: flex-end; gap: 24rpx;
  animation: fabIn 0.22s ease-out;
}
@keyframes fabIn {
  from { opacity: 0; transform: translateY(20rpx) scale(0.9); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.fab-agent {
  display: flex; align-items: center; gap: 16rpx;
  background: #fff; padding: 16rpx 24rpx 16rpx 16rpx;
  border-radius: 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.18);
}
.fab-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: linear-gradient(135deg, #FF9259, #A63B00);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.fab-name { font-size: 28rpx; font-weight: 600; color: #2A2A2A; }
.fab-phone { font-size: 24rpx; color: #888; margin-left: 4rpx; }
