<view class="home">
  <!-- Banner 轮播 -->
  <view class="banner">
    <swiper class="sw" autoplay indicator-dots="{{false}}" circular bindchange="onSwiperChange">
      <swiper-item wx:for="{{banners}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" class="b-img" data-i="{{index}}" binderror="onBannerError"/>
      </swiper-item>
    </swiper>
    <view class="b-mask">
      <view wx:if="{{homeTag}}" class="b-tag">{{homeTag}}</view>
      <view class="b-title">{{homeTitle}}</view>
      <view wx:if="{{homeSubtitle}}" class="b-sub">{{homeSubtitle}}</view>
    </view>
    <view class="b-dots">
      <view wx:for="{{banners}}" wx:key="index" class="d {{bannerIdx === index ? 'd-on' : ''}}"></view>
    </view>
  </view>

  <!-- 公司信息 -->
  <view class="page-wrap">
    <!-- 关于公司 -->
    <section-title title="关于公司" extra-en="ABOUT US"/>
    <view class="about-card">
      <view class="ac-left" bindtap="onAbout">
        <view class="ac-logo"><text>🏢</text></view>
        <view class="ac-link">关于我们 ›</view>
      </view>
      <view class="ac-right">
        <view wx:for="{{offices}}" wx:key="city" class="ac-o" data-i="{{index}}" bindtap="onNavAddr">
          <view class="ac-city">📍 {{item.city}}</view>
          <view class="ac-addr">{{item.addr}}</view>
        </view>
        <view wx:if="{{!offices.length}}" class="ac-empty">暂无地址信息</view>
      </view>
    </view>

    <!-- 工程案例 -->
    <section-title title="局部工程案例" extra-en="VIEW MORE"/>
    <scroll-view scroll-x class="case-scroll" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{cases}}" wx:key="_id" class="cs-item" data-id="{{item._id}}" bindtap="onCase">
        <image src="{{item.cover || caseFallback}}" mode="aspectFill" class="cs-img" data-i="{{index}}" binderror="onCaseImgError"/>
        <view class="cs-title">{{item.title}}</view>
      </view>
      <view wx:if="{{!cases.length}}" class="cs-item cs-empty">
        <image src="/images/default-cover.png" mode="aspectFill" class="cs-img"/>
        <view class="cs-title">沈阳科技总部园玻璃隔断工程</view>
        <view class="cs-sub">示例数据 · 4200㎡</view>
      </view>
    </scroll-view>

    <!-- 实力卡片 -->
    <view class="brand-card">
      <view class="bc-title">{{homeSubtitle}}</view>
      <view class="bc-sub">{{homeSlogan}}</view>
      <view class="bc-btn" bindtap="onGoInquiry">立即获取报价方案</view>
    </view>
  </view>

  <view wx:if="{{fabOpen && agents.length}}" class="fab-overlay">
    <view class="fab-agent" wx:for="{{agents}}" wx:key="phone" data-phone="{{item.phone}}" catchtap="onCallAgent">
      <view class="fab-avatar">{{item.gender === 'female' ? '👩‍💼' : '👨‍💼'}}</view>
      <view class="fab-name">{{item.name}}</view>
      <view class="fab-phone">{{item.phone}}</view>
    </view>
  </view>

  <floating-btn icon="{{fabOpen ? '✕' : ''}}" image="{{fabOpen ? '' : '/images/service.png'}}" bottom="{{200}}" bindtap="onFab"/>
</view>
