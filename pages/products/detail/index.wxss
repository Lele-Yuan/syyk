.prd-detail { background: #fff; min-height: 100vh; padding-bottom: 180rpx; }
.hero { position: relative; width: 100%; height: 700rpx; }
.hero .sw { width: 100%; height: 100%; }
.h-img { width: 100%; height: 100%; }
.h-tag {
  position: absolute; left: 32rpx; bottom: 64rpx;
  padding: 12rpx 28rpx;
  background: rgba(0,32,69,0.9);
  color: #fff; font-size: 24rpx;
  border-radius: 12rpx;
}
.h-dots {
  position: absolute; bottom: 32rpx; right: 40rpx;
  display: flex; gap: 12rpx;
}
.h-dots .d { width: 24rpx; height: 8rpx; border-radius: 4rpx; background: rgba(196,198,207,0.8); }
.h-dots .d.on { width: 48rpx; background: #002045; }

.title { font-size: 44rpx; color: #002045; font-weight: 700; margin-top: 16rpx; }
.desc { font-size: 28rpx; color: #43474E; line-height: 1.7; margin-top: 24rpx; }

.features {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 48rpx 0;
}
.features .f-card:first-child { grid-column: 1 / span 2; }
.f-card {
  border: 2rpx solid rgba(196,198,207,0.3);
  border-radius: 20rpx;
  padding: 32rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.f-ic { font-size: 36rpx; margin-bottom: 8rpx; }
.f-title { font-size: 32rpx; color: #181C1E; font-weight: 600; }
.f-desc { font-size: 24rpx; color: #43474E; margin-top: 8rpx; line-height: 1.6; }

.specs {
  margin-top: 24rpx;
  border: 2rpx solid rgba(196,198,207,0.3);
  border-radius: 20rpx;
  overflow: hidden;
}
.sp-head, .sp-row {
  display: flex;
}
.sp-head {
  background: #EBEEF0;
  padding: 24rpx 32rpx;
  font-size: 24rpx; color: #43474E;
}
.sp-row {
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #EBEEF0;
}
.sp-c1 { width: 240rpx; color: #43474E; font-size: 28rpx; }
.sp-c2 { flex: 1; color: #002045; font-size: 28rpx; font-family: Menlo, monospace; }
.sp-empty { padding: 48rpx; text-align: center; color: #67717E; }

.cmp-card {
  margin: 48rpx 0;
  background: #1A365D;
  border-radius: 24rpx;
  padding: 40rpx;
  color: #fff;
}
.cmp-title { font-size: 36rpx; font-weight: 600; }
.cmp-sub { margin-top: 12rpx; font-size: 24rpx; color: #86A0CD; }
.cmp-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 20rpx 40rpx;
  background: #A63B00;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.cs-scroll { white-space: nowrap; margin: 16rpx 0 32rpx; }
.cs-item { display: inline-block; width: 480rpx; margin-right: 24rpx; vertical-align: top; }
.cs-img { width: 100%; height: 300rpx; border-radius: 20rpx; }
.cs-title { margin-top: 16rpx; font-size: 30rpx; color: #002045; font-weight: 600; }
.cs-sub { font-size: 24rpx; color: #43474E; margin-top: 4rpx; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20rpx);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; gap: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}
.bb-side { display: flex; gap: 24rpx; }
.bb-i { display: flex; flex-direction: column; align-items: center; font-size: 20rpx; color: #43474E; }
.bb-ic { font-size: 40rpx; line-height: 1; color: #002045; margin-bottom: 4rpx; }
.bb-actions { flex: 1; display: flex; gap: 16rpx; }
.bb-out {
  flex: 1; text-align: center;
  border: 2rpx solid #A63B00; color: #A63B00;
  border-radius: 16rpx; padding: 22rpx 0;
  font-size: 30rpx; font-weight: 600;
}
.bb-pri {
  flex: 1; text-align: center;
  background: #A63B00; color: #fff;
  border-radius: 16rpx; padding: 24rpx 0;
  font-size: 30rpx; font-weight: 600;
}
