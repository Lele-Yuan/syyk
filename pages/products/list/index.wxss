.prd-list { background: #fff; min-height: 100vh; }
.hero { position: relative; width: 100%; height: 500rpx; background: #F1F4F6; }
.hero-img { width: 100%; height: 100%; }
.hero-tag {
  position: absolute; left: 32rpx; bottom: 32rpx;
  padding: 12rpx 28rpx;
  background: rgba(0,32,69,0.9);
  color: #fff; font-size: 24rpx;
  border-radius: 12rpx; backdrop-filter: blur(8rpx);
}
.page-wrap {
  position: relative;
  margin-top: -200rpx;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: linear-gradient(to bottom, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.92) 200rpx, #fff 240rpx);
  backdrop-filter: blur(12rpx);
}
.title { font-size: 44rpx; color: #002045; font-weight: 700; margin-top: 16rpx; }
.subtitle { font-size: 26rpx; color: #43474E; margin-top: 12rpx; margin-bottom: 32rpx; }

.filter-card {
  border: 2rpx solid rgba(196,198,207,0.3);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05);
}
.filter-card .row { display: flex; align-items: center; }
.filter-card .ic { font-size: 28rpx; margin-right: 16rpx; }
.filter-card .lab { flex: 1; font-size: 28rpx; color: #002045; }
.filter-card .arrow { color: #67717E; font-size: 22rpx; }
.filter-body { padding-top: 24rpx; }
.f-row {
  display: flex; align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid #F1F4F6;
}
.f-lab { width: 160rpx; font-size: 26rpx; color: #43474E; }
.f-val { flex: 1; text-align: right; font-size: 26rpx; color: #002045; }
.f-keyword-input {
  flex: 1; font-size: 28rpx; color: #002045;
  background: #F5F7FA; border-radius: 12rpx;
  padding: 16rpx 24rpx; width: 100%;
}
.f-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.f-btn {
  flex: 1; text-align: center; padding: 20rpx;
  border-radius: 12rpx; font-size: 28rpx;
}
.f-reset { background: #F1F4F6; color: #43474E; }
.f-apply { background: #A63B00; color: #fff; }
.list { display: flex; flex-direction: column; }
