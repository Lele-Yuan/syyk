<view class="prd-list">
  <!-- Banner -->
  <view class="hero">
    <image src="{{heroCover}}" mode="aspectFill" class="hero-img" binderror="onHeroError"/>
  </view>

  <view class="page-wrap">
    <view class="title">{{heroTitle}}</view>
    <view class="subtitle">{{heroSubtitle}}</view>

    <!-- 筛选 -->
    <view class="filter-card" bindtap="toggleFilter">
      <view class="row">
        <view class="ic">🔍</view>
        <view class="lab">关键字筛选</view>
        <view class="arrow">{{showFilter ? '▲' : '▼'}}</view>
      </view>
      <view wx:if="{{showFilter}}" class="filter-body" catchtap="noop">
        <view class="f-row">
          <input class="f-keyword-input" placeholder="输入产品名称、材质、系列..."
                 value="{{keyword}}" bindinput="onKeywordInput"
                 confirm-type="search" bindconfirm="onApply"/>
        </view>
        <view class="f-actions">
          <view class="f-btn f-reset" catchtap="onReset">重置</view>
          <view class="f-btn f-apply" catchtap="onApply">搜索</view>
        </view>
      </view>
    </view>

    <view class="list">
      <product-card wx:for="{{products}}" wx:key="_id" item="{{item}}"
                    bind:tap="onCardTap" bind:inquiry="onInquiry"/>
      <view wx:if="{{!loading && !products.length}}" class="empty-state">
        {{keyword ? '未找到匹配的产品，请尝试其他关键字' : '暂无产品，等待管理员发布'}}
      </view>
    </view>
  </view>

  <floating-btn image="/images/top.png" bottom="{{180}}" bindtap="onScrollTop"/>
</view>
