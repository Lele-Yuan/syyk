.cs-list { background: #fff; min-height: 100vh; }
.hd { padding: 32rpx 0; }
.hd-en { font-size: 22rpx; color: #A63B00; letter-spacing: 2rpx; font-family: Menlo, monospace; }
.hd-title { font-size: 48rpx; color: #002045; font-weight: 700; margin-top: 12rpx; }
.hd-sub { font-size: 26rpx; color: #43474E; margin-top: 16rpx; line-height: 1.6; }

.tabs { white-space: nowrap; margin: 32rpx -40rpx; padding-left: 40rpx; padding-right: 40rpx; }
.tab {
  display: inline-block;
  padding: 16rpx 36rpx;
  border: 2rpx solid #C4C6CF;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #181C1E;
  margin-right: 16rpx;
  background: #fff;
}
.tab.on { background: #002045; color: #fff; border-color: #002045; }

.brand-card {
  margin-top: 48rpx;
  background: #002045;
  border-radius: 32rpx;
  padding: 56rpx 48rpx;
  text-align: center;
  color: #fff;
}
.bc-icon { font-size: 72rpx; line-height: 1; margin: 0 auto 16rpx; }
.bc-title { font-size: 36rpx; font-weight: 600; }
.bc-sub { margin-top: 12rpx; font-size: 26rpx; color: #86A0CD; }
.bc-btn {
  display: inline-block; margin-top: 32rpx;
  padding: 24rpx 64rpx;
  background: #A63B00; color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx; font-weight: 600;
}
