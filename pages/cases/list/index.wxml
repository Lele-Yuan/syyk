<view class="cs-list">
  <view class="page-wrap">
    <view class="hd">
      <view class="hd-en">PROJECT SHOWCASE</view>
      <view class="hd-title">{{heroTitle}}</view>
      <view class="hd-sub">{{heroSubtitle}}</view>
    </view>

    <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{tabs}}" wx:key="id"
            class="tab {{activeTab === item.id ? 'on' : ''}}"
            data-id="{{item.id}}" bindtap="onTab">{{item.label}}</view>
    </scroll-view>

    <view class="list">
      <case-card wx:for="{{cases}}" wx:key="_id" item="{{item}}" bind:tap="onCardTap"/>
      <view wx:if="{{!loading && !cases.length}}" class="empty-state">暂无工程案例</view>
    </view>

    <!-- CTA -->
    <view class="brand-card">
      <view class="bc-icon">🏆</view>
      <view class="bc-title">{{homeSubtitle}}</view>
      <view class="bc-sub">{{homeSlogan}}</view>
      <view class="bc-btn" bindtap="onInquiry">立即获取报价方案</view>
    </view>
  </view>
</view>
