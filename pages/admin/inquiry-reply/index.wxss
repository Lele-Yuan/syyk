.reply { background: #F1F4F6; min-height: 100vh; padding: 32rpx 32rpx 220rpx; }
.head-card {
  background: linear-gradient(135deg, #002045, #1A365D);
  color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
}
.title-row { display: flex; justify-content: space-between; align-items: center; }
.t { font-size: 34rpx; font-weight: 600; }
.badge { padding: 4rpx 16rpx; border-radius: 12rpx; font-size: 22rpx; }
.st-pending { background: #FFD18A; color: #6E2A00; }
.st-replied { background: #B7EBD0; color: #11543A; }
.st-closed { background: #C7CCD3; color: #181C1E; }
.time { font-size: 24rpx; opacity: 0.8; margin-top: 12rpx; }

.card { background: #fff; border-radius: 24rpx; padding: 8rpx 24rpx; margin-bottom: 16rpx; }
.kv { display: flex; padding: 20rpx 0; border-top: 2rpx solid #F1F4F6; font-size: 28rpx; }
.kv:first-child { border-top: 0; }
.kv.v { flex-direction: column; gap: 8rpx; }
.k { width: 160rpx; color: #67717E; flex-shrink: 0; }
.v { flex: 1; color: #181C1E; }
.v.link { color: #A63B00; }

.history { padding: 24rpx; }
.h-time { font-size: 22rpx; color: #C4C6CF; }
.h-content { font-size: 28rpx; color: #181C1E; line-height: 1.7; margin-top: 8rpx; }

.ta { width: 100%; min-height: 240rpx; padding: 16rpx 0; font-size: 28rpx; color: #181C1E; }

.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 24rpx 32rpx env(safe-area-inset-bottom);
  background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  display: flex; gap: 16rpx;
}
.btn-close {
  flex: 1; height: 96rpx; line-height: 96rpx;
  background: #fff; color: #67717E;
  border: 2rpx solid #C4C6CF;
  border-radius: 48rpx; font-size: 30rpx;
}
.btn-send {
  flex: 2; height: 96rpx; line-height: 96rpx;
  background: #A63B00; color: #fff;
  border-radius: 48rpx; font-size: 32rpx;
}
.btn-send.disabled { opacity: 0.6; }
