<view class="content-mgr">
  <view class="hd">
    <view class="hd-title">内容管理</view>
    <view class="hd-sub">管理站点的静态内容与配置</view>
  </view>
  <view class="cards">
    <view wx:for="{{items}}" wx:key="title" class="card"
          data-url="{{item.url}}" bindtap="onTap">
      <view class="ic">{{item.icon}}</view>
      <view class="info">
        <view class="title">{{item.title}}</view>
        <view class="desc">{{item.desc}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>
</view>
