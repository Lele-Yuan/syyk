<view class="hero-edit">
  <view class="section">
    <view class="sec-title">主标题</view>
    <input class="ipt" placeholder="例如：工程作品"
           value="{{form.title}}" data-k="title" bindinput="onFieldInput" maxlength="20"/>
  </view>

  <view class="section">
    <view class="sec-title">副标题</view>
    <textarea class="ta" placeholder="例如：扎根东北，服务全国。…"
              value="{{form.subtitle}}" data-k="subtitle" bindinput="onFieldInput"
              auto-height maxlength="120"/>
  </view>

  <view class="actions">
    <view class="btn primary {{submitting ? 'disabled' : ''}}" bindtap="onSave">
      {{submitting ? '保存中...' : '保存'}}
    </view>
  </view>
</view>
