.mgr { background: #F1F4F6; min-height: 100vh; padding-bottom: 64rpx; }
.bar { display: flex; justify-content: space-between; align-items: center; padding: 32rpx; background: #fff; }
.bar-title { font-size: 32rpx; font-weight: 600; color: #002045; }
.bar-add { background: #A63B00; color: #fff; padding: 12rpx 28rpx; border-radius: 24rpx; font-size: 26rpx; }
.empty { padding: 120rpx 32rpx; text-align: center; color: #67717E; font-size: 26rpx; }
.list { padding: 16rpx 32rpx; }
.item { margin-top: 24rpx; }
.card { background: #fff; border-radius: 24rpx; overflow: hidden; }
.cover { width: 100%; height: 280rpx; }
.info { padding: 24rpx; }
.title { font-size: 30rpx; color: #002045; font-weight: 600; }
.meta { font-size: 24rpx; color: #67717E; margin-top: 8rpx; }
.acts { display: flex; padding: 0 24rpx 24rpx; gap: 16rpx; }
.btn-edit, .btn-del {
  flex: 1; text-align: center; padding: 16rpx 0;
  border-radius: 16rpx; font-size: 26rpx;
}
.btn-edit { background: #002045; color: #fff; }
.btn-del { background: #FBE9E1; color: #A63B00; }
