.edit { background: #F1F4F6; min-height: 100vh; padding: 32rpx 32rpx 200rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 8rpx 24rpx; margin-bottom: 24rpx; }
.row { display: flex; align-items: center; padding: 20rpx 0; border-top: 2rpx solid #F1F4F6; font-size: 28rpx; }
.row:first-child { border-top: 0; }
.row.v { flex-direction: column; align-items: stretch; }
.lab { width: 160rpx; color: #67717E; flex-shrink: 0; }
.row.v .lab { width: auto; margin-bottom: 12rpx; }
.ipt { flex: 1; color: #181C1E; }
.series-pick { flex: 1; }
.series-btn { padding: 4rpx 0; color: #181C1E; font-size: 28rpx; }
.ta { width: 100%; min-height: 200rpx; padding: 16rpx 0; font-size: 28rpx; color: #181C1E; }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 24rpx 32rpx env(safe-area-inset-bottom);
  background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}
.btn-submit {
  width: 100%; height: 96rpx; line-height: 96rpx;
  background: #A63B00; color: #fff;
  border-radius: 48rpx; font-size: 32rpx;
}
.btn-submit.disabled { opacity: 0.6; }

/* 所用材料 */
.mat-row {
  padding: 20rpx 0;
  border-top: 2rpx solid #F1F4F6;
}
.mat-row:first-child { border-top: 0; }
.mat-h { display: flex; align-items: center; gap: 12rpx; }
.mat-ic-emoji { font-size: 36rpx; flex-shrink: 0; }
.mat-name { flex: 1; font-size: 28rpx; color: #181C1E; }
.mat-rm {
  width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  color: #C4C6CF; font-size: 36rpx;
}
.mat-desc-ipt {
  margin-top: 12rpx; padding: 12rpx 16rpx;
  background: #F1F4F6; border-radius: 12rpx;
  font-size: 26rpx; color: #43474E;
}
.mat-tag {
  display: inline-block; margin-top: 12rpx;
  padding: 4rpx 16rpx; background: #E1F4EA; color: #1B7F4F;
  border-radius: 12rpx; font-size: 22rpx;
}
.mat-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.mat-btn {
  flex: 1; text-align: center; padding: 20rpx 0;
  background: #F1F4F6; color: #43474E;
  border-radius: 16rpx; font-size: 26rpx;
}
.mat-btn.primary { background: #002045; color: #fff; }
