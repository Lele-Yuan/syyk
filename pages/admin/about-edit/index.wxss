.about-edit { padding: 24rpx 24rpx 200rpx; background: #f6f7f9; min-height: 100vh; }
.section { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; color: #002045; margin-bottom: 20rpx; }
.ta {
  width: 100%; min-height: 180rpx; box-sizing: border-box;
  background: #f3f5f8; border-radius: 10rpx; padding: 20rpx;
  font-size: 28rpx; color: #002045;
}
.ipt {
  background: #f3f5f8; border-radius: 10rpx;
  padding: 20rpx 24rpx; font-size: 28rpx; color: #002045;
  margin-bottom: 16rpx;
}
.office-row {
  border: 1rpx solid #eee; border-radius: 12rpx;
  padding: 20rpx; margin-bottom: 20rpx;
}
.o-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.o-idx { font-size: 26rpx; color: #888; }
.o-rm { font-size: 24rpx; color: #d23b3b; padding: 6rpx 16rpx; }
.o-loc-row { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; }
.o-loc-btn {
  flex: 1; text-align: center; padding: 16rpx;
  background: #eef4ff; color: #4a6cf7;
  border-radius: 8rpx; font-size: 26rpx;
}
.o-loc-ok { font-size: 24rpx; color: #11543A; }
.add-btn {
  text-align: center; padding: 24rpx; border: 2rpx dashed #c8d1de;
  border-radius: 10rpx; color: #002045; font-size: 28rpx;
}
.actions {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx; background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06);
}
.btn {
  height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 44rpx; font-size: 30rpx;
}
.btn.primary { background: #A63B00; color: #fff; }
.btn.primary.disabled { opacity: .6; }
.qua-row {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx;
}
.qua-row .qua-ipt { flex: 1; margin-bottom: 0; }
