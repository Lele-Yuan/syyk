.mgr { background: #F1F4F6; min-height: 100vh; padding-bottom: 64rpx; }
.tabs {
  display: flex; background: #fff;
  padding: 16rpx 0;
  position: sticky; top: 0; z-index: 10;
}
.tab {
  flex: 1; text-align: center; padding: 16rpx 0;
  font-size: 26rpx; color: #67717E;
  position: relative;
}
.tab.active { color: #002045; font-weight: 600; }
.tab.active::after {
  content: ''; position: absolute; left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 48rpx; height: 4rpx; background: #A63B00;
}
.empty { padding: 120rpx 32rpx; text-align: center; color: #67717E; }
.list { padding: 16rpx 32rpx; }
.item {
  background: #fff; border-radius: 24rpx;
  padding: 28rpx; margin-top: 24rpx;
  display: flex; gap: 20rpx; align-items: flex-start;
}
.item .avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  flex-shrink: 0; background: #ECEEF0;
}
.item .body { flex: 1; min-width: 0; }
.head { display: flex; justify-content: space-between; align-items: center; }
.t { font-size: 30rpx; color: #002045; font-weight: 600; }
.badge { padding: 4rpx 16rpx; border-radius: 12rpx; font-size: 22rpx; }
.st-pending { background: #FFF1E0; color: #A63B00; }
.st-replied { background: #E1F4EA; color: #1B7F4F; }
.st-closed { background: #ECEEF0; color: #67717E; }
.meta { font-size: 26rpx; color: #43474E; margin-top: 12rpx; }
.addr { font-size: 24rpx; color: #67717E; margin-top: 8rpx; }
.time { font-size: 22rpx; color: #C4C6CF; margin-top: 12rpx; }
