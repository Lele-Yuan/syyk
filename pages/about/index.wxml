<view class="ab">
  <view class="hero">
    <image src="/images/default-cover.png" mode="aspectFill" class="h-img"/>
    <view class="h-mask">
      <view class="brand">沈阳银科隔墙</view>
      <view class="slogan">东北工业级隔断系统领导品牌</view>
    </view>
  </view>

  <view class="page-wrap">
    <section-title title="关于银科" extra-en="ABOUT US"/>
    <view class="card intro">{{intro}}</view>

    <section-title title="办公地址"/>
    <view wx:for="{{offices}}" wx:key="city" class="card office">
      <view class="o-city">{{item.city}}</view>
      <view class="o-row" data-i="{{index}}" bindtap="onNavAddr">
        <text class="o-ic">📍</text><text class="o-val o-phone">{{item.addr}}</text>
      </view>
      <view wx:if="{{item.phone}}" class="o-row" data-phone="{{item.phone}}" bindtap="onCall">
        <text class="o-ic">📞</text><text class="o-val o-phone">{{item.phone}}</text>
      </view>
    </view>

    <section-title title="企业资质"/>
    <view class="card qua">
      <view wx:for="{{qualifications}}" wx:key="index" class="q-i">✓ {{item}}</view>
    </view>
  </view>
</view>
