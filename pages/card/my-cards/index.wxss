.mc { background: #F1F4F6; min-height: 100vh; padding: 24rpx 32rpx 160rpx; }
.empty { padding: 120rpx 32rpx; text-align: center; color: #67717E; }

.empty-wrap { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.empty-ic { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 36rpx; font-weight: 600; color: #002045; margin-bottom: 12rpx; }
.empty-sub { font-size: 28rpx; color: #67717E; text-align: center; margin-bottom: 48rpx; line-height: 1.6; }
.create-btn {
  padding: 24rpx 64rpx; background: #A63B00; color: #fff;
  border-radius: 48rpx; font-size: 30rpx; font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(166,59,0,0.3);
}

.list { display: flex; flex-direction: column; gap: 20rpx; }

/* 滑动容器 */
.swipe-wrap {
  position: relative; border-radius: 20rpx;
  overflow: hidden;
}

/* 操作按钮层（始终在右侧，宽 160rpx） */
.swipe-actions {
  position: absolute; right: 0; top: 0; bottom: 0;
  display: flex; width: 280rpx;
}
.sa-edit, .sa-delete {
  flex: 1; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #fff; font-weight: 600;
}
.sa-edit { background: #4A6CF7; }
.sa-delete { background: #d23b3b; }

/* 名片内容层 */
.card-item {
  position: relative; z-index: 1;
  background: #fff; border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex; align-items: center; gap: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: transform 0.25s ease;
  transform: translateX(0);
}
.card-item.swiped { transform: translateX(-280rpx); }

.ci-avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: linear-gradient(135deg, #002045, #1A365D);
  flex-shrink: 0;
}
.ci-avatar-text {
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700; color: #fff;
}
.ci-body { flex: 1; min-width: 0; }
.ci-name { font-size: 32rpx; font-weight: 600; color: #002045; margin-bottom: 4rpx; }
.ci-title { font-size: 26rpx; color: #43474E; font-weight: 400; }
.ci-phone { font-size: 26rpx; color: #74777F; margin-top: 4rpx; }
.ci-remark { font-size: 24rpx; color: #A63B00; margin-top: 6rpx; }
.ci-arrow { color: #C4C6CF; font-size: 40rpx; }

.fab {
  position: fixed; right: 48rpx; bottom: 160rpx;
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: #A63B00; color: #fff;
  font-size: 56rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(166,59,0,0.35); z-index: 10;
}
