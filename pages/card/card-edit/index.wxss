.edit { background: #F1F4F6; min-height: 100vh; padding: 24rpx 32rpx 180rpx; }
.section { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; color: #002045; margin-bottom: 20rpx; }
.sec-sub { font-size: 24rpx; color: #74777F; margin-bottom: 12rpx; }
.sec-sub.mt { margin-top: 20rpx; }
.ipt {
  background: #F1F4F6; border-radius: 12rpx;
  padding: 20rpx 24rpx; font-size: 28rpx; color: #002045;
  margin-bottom: 16rpx; display: block;
}
.ipt.last { margin-bottom: 0; }
.ta { min-height: 80rpx; }

/* 主营业务 */
.area-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.area-tag {
  padding: 14rpx 28rpx; border-radius: 12rpx;
  background: #F1F4F6; border: 2rpx solid #ECEEF0;
  font-size: 28rpx; color: #43474E;
}
.area-on { background: #FFF1E0; border-color: #A63B00; color: #A63B00; font-weight: 600; }
.custom-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.custom-tag {
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 20rpx; border-radius: 40rpx;
  background: #E8F0FF; border: 1rpx solid #4A6CF7;
  font-size: 26rpx; color: #4A6CF7;
}
.ct-rm { font-size: 30rpx; color: #4A6CF7; padding: 0 4rpx; }
.custom-input-row { display: flex; gap: 16rpx; align-items: center; margin-top: 8rpx; }
.custom-ipt { flex: 1; margin-bottom: 0; }
.add-tag-btn {
  flex-shrink: 0; padding: 20rpx 28rpx;
  background: #002045; color: #fff;
  border-radius: 12rpx; font-size: 26rpx; white-space: nowrap;
}

/* 办公地址 & 品质 */
.office-row, .ach-row {
  border: 1rpx solid #ECEEF0; border-radius: 12rpx;
  padding: 20rpx; margin-bottom: 20rpx;
}
.o-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.o-idx { font-size: 26rpx; color: #888; }
.o-rm { font-size: 24rpx; color: #d23b3b; padding: 6rpx 16rpx; }
.loc-row { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; }
.loc-btn {
  flex: 1; text-align: center; padding: 16rpx;
  background: #EEF4FF; color: #4A6CF7;
  border-radius: 8rpx; font-size: 26rpx;
}
.loc-ok { font-size: 24rpx; color: #1B7F4F; }

.add-btn {
  text-align: center; padding: 24rpx; border: 2rpx dashed #C8D1DE;
  border-radius: 10rpx; color: #002045; font-size: 28rpx; margin-top: 4rpx;
}

/* 操作 */
.actions {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx; background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.btn-save {
  height: 88rpx; line-height: 88rpx; text-align: center;
  background: #A63B00; color: #fff;
  border-radius: 44rpx; font-size: 32rpx; font-weight: 600;
}
.btn-save.disabled { opacity: 0.6; }

/* 头像 */
.avatar-row { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; }
.avatar-btn {
  position: relative; width: 120rpx !important; height: 120rpx;
  border-radius: 50%; padding: 0; margin: 0;
  background: none; border: none; flex-shrink: 0;
  overflow: visible;
}
.av-img {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  border: 3rpx solid rgba(0,32,69,0.15);
}
.av-placeholder {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(135deg, #002045, #1A365D);
  display: flex; align-items: center; justify-content: center;
}
.av-ic { font-size: 56rpx; }
.av-edit-badge {
  position: absolute; right: -4rpx; bottom: -4rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #A63B00; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; border: 3rpx solid #fff;
}
.avatar-hint { flex: 1; }
.ah-title { font-size: 30rpx; font-weight: 600; color: #002045; margin-bottom: 6rpx; }
.ah-sub { font-size: 24rpx; color: #74777F; }
